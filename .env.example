# Copy to ~/.config/accelscan.env (or ./.env) and fill in. SLURM scripts do:
#   set -a; source $HOME/.config/accelscan.env; set +a
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ACCELSCAN_S3_ENDPOINT=https://s3.msi.umn.edu
S2_API_KEY=

# Separate, full-fledged AWS account hosting the public website (S3 +
# CloudFront) -- NOT the same account as AWS_ACCESS_KEY_ID/SECRET above,
# which are MSI's S3-compatible endpoint. Only scripts/deploy_site.sh reads
# these (see its header comment for exactly where the override happens).
SITE_AWS_ACCESS_KEY_ID=
SITE_AWS_SECRET_ACCESS_KEY=
SITE_AWS_REGION=us-east-1
